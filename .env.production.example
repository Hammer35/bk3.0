BOOSTKLIENT_IMAGE=registry.example.com/boostklient:3.0.0
APP_DOMAIN=app.example.com
ACME_EMAIL=ops@example.com
DJANGO_SECRET_KEY=replace-with-a-50-character-random-secret
DJANGO_ALLOWED_HOSTS=app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com
GIGACHAT_API_TOKEN=
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_MODEL_PRIORITY=GigaChat-2,GigaChat-3-Lightning,GigaChat-2-Pro,GigaChat-3-Pro,GigaChat-2-Max,GigaChat-3-Ultra
GIGACHAT_AVAILABLE_MODELS_CACHE_SECONDS=300
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Override only when your GigaChat project requires another trusted CA bundle.
GIGACHAT_CA_BUNDLE_FILE=/app/infra/certs/russian_trusted_root_ca_pem.crt
POSTGRES_DB=boostklient
POSTGRES_USER=boostklient
POSTGRES_PASSWORD=replace-with-production-database-password
POSTGRES_HOST=managed-postgres.example.com
POSTGRES_PORT=5432
